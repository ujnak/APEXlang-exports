app STATION-PASSENGERS-NATIVE (
    name: 駅の乗降客数マップ（APEX標準）
    logo {
        type: text
        text: &APP_TITLE.
    }
    navigation {
        homeUrl: {
            page: 1
        }
        loginUrl: {
            page: 9999
        }
    }
    navigationMenu {
        listTemplate: @/side-navigation-menu
        templateOptions: [
            #DEFAULT#
            js-defaultCollapsed
            js-navCollapsed--hidden
            t-TreeNav--styleA
        ]
        list: @navigation-menu
    }
    navigationBar {
        list: @navigation-bar
        listTemplate: @/navigation-bar
        templateOptions: #DEFAULT#
    }
    userInterface {
        currentTheme: @universal-theme
        globalPage: 0
        addBuiltWithApexToFooter: false
    }
    appFormatMasks {
        date: DS
        timestamp: DS
        timestampTimeZone: DS
    }
    authentication {
        scheme: @oracle-apex-accounts
    }
    authorization {
        sourceForRoleOrGroupSchemes: authenticationScheme
    }
    sessionStateProtection {
        checksumSalt: F71EAF033852E78DB18109B13D1A5F9835FEFE197B30E2416834E63C4D680128
    }
    sessionManagement {
        maxSessionLength: 28800
        maxSessionIdleTime: 3600
    }
    globalization {
        primaryLanguage: ja
    }
    runtime {
        allowFeedback: true
        compatibilityMode: 24.2
    }
)

