page 1 (
    name: Policy Violations
    alias: HOME
    title: CSP Report
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText:
            ```html
            <p>データを見つけるには、検索ダイアログに検索文字列を入力するか、列ヘッダーをクリックして戻されるレコードを制限します。</p>
            
            <p><strong>「アクション」</strong>ボタンをクリックすると、多くの機能を実行できます。これには、表示列または非表示列の選択とその表示順序に加え、多くのデータおよび書式設定機能が含まれます。チャート、グループ化およびピボット・オプションを使用して、データの追加ビューを定義することもできます。</p>
            
            <p>独自のカスタマイズ内容を保存する場合、レポートを選択するか、「ダウンロード」をクリックしてデータをアンロードします。定期的にデータを送信するサブスクリプションで電子メール・アドレスと時間枠を入力します。<p>
            
            <p>追加情報を入手するには、「アクション」メニューの一番下の「ヘルプ」をクリックします。</p>
            
            <p><strong>「リセット」</strong>ボタンをクリックすると、対話モード・レポートをデフォルト設定に戻すことができます。</p>
            ```
    }

    region csp-report (
        name: CSP Report
        type: staticContent
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/hero
            templateOptions: #DEFAULT#
        }
        image {
            fileUrl: #APP_FILES#icons/app-icon-512.png
        }
    )

    region policy-violations (
        name: Policy Violations
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                  jd.id,
                  jt.document_uri,
                  jt.referrer,
                  jt.violated_directive,
                  jt.effective_directive,
                  jt.original_policy,
                  jt.disposition,
                  jt.blocked_uri,
                  jt.line_number,
                  jt.column_number,
                  jt.source_file,
                  jt.status_code,
                  jt.script_sample,
                  jd.created
                FROM ebaj_csp_reports jd,
                     JSON_TABLE(
                       jd.report,
                       '$."csp-report"'
                       COLUMNS (
                         document_uri VARCHAR2(200) PATH '$."document-uri"',
                         referrer VARCHAR2(200) PATH '$."referrer"',
                         violated_directive VARCHAR2(200) PATH '$."violated-directive"',
                         effective_directive VARCHAR2(200) PATH '$."effective-directive"',
                         original_policy VARCHAR2(500) PATH '$."original-policy"',
                         disposition VARCHAR2(50) PATH '$."disposition"',
                         blocked_uri VARCHAR2(200) PATH '$."blocked-uri"',
                         line_number NUMBER PATH '$."line-number"',
                         column_number NUMBER PATH '$."column-number"',
                         source_file VARCHAR2(200) PATH '$."source-file"',
                         status_code NUMBER PATH '$."status-code"',
                         script_sample VARCHAR2(500) PATH '$."script-sample"'
                       )
                     ) jt;
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: データが見つかりません。
            whenMoreDataFound: このレポートの最大行数は#MAX_ROW_COUNT#行です。フィルタを適用して、問合せのレコード数を削減してください。
        }
        actionsMenu {
            savePublicReport: true
        }
        advanced {
            savedReportMappingIdentifier: 14510450929099650
        }

        column BLOCKED_URI (
            type: plainText
            heading {
                heading: Blocked Uri
            }
            layout {
                sequence: 8
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: H
            }
        )

        column COLUMN_NUMBER (
            type: plainText
            heading {
                heading: Column Number
                alignment: end
            }
            layout {
                sequence: 10
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: J
            }
        )

        column CREATED (
            type: plainText
            heading {
                heading: Created
            }
            layout {
                sequence: 14
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: N
            }
        )

        column DISPOSITION (
            type: plainText
            heading {
                heading: Disposition
            }
            layout {
                sequence: 7
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: G
            }
        )

        column DOCUMENT_URI (
            type: plainText
            heading {
                heading: Document Uri
            }
            layout {
                sequence: 2
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: B
            }
        )

        column EFFECTIVE_DIRECTIVE (
            type: plainText
            heading {
                heading: Effective Directive
            }
            layout {
                sequence: 5
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: E
            }
        )

        column ID (
            type: plainText
            heading {
                heading: Id
                alignment: end
            }
            layout {
                sequence: 1
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: A
            }
        )

        column LINE_NUMBER (
            type: plainText
            heading {
                heading: Line Number
                alignment: end
            }
            layout {
                sequence: 9
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: I
            }
        )

        column ORIGINAL_POLICY (
            type: plainText
            heading {
                heading: Original Policy
            }
            layout {
                sequence: 6
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: F
            }
        )

        column REFERRER (
            type: plainText
            heading {
                heading: Referrer
            }
            layout {
                sequence: 3
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: C
            }
        )

        column SCRIPT_SAMPLE (
            type: plainText
            heading {
                heading: Script Sample
            }
            layout {
                sequence: 13
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: M
            }
        )

        column SOURCE_FILE (
            type: plainText
            heading {
                heading: Source File
            }
            layout {
                sequence: 11
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: K
            }
        )

        column STATUS_CODE (
            type: plainText
            heading {
                heading: Status Code
                alignment: end
            }
            layout {
                sequence: 12
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: L
            }
        )

        column VIOLATED_DIRECTIVE (
            type: plainText
            heading {
                heading: Violated Directive
            }
            layout {
                sequence: 4
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: D
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Policy Violations
        }

        savedReport 145201 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn BLOCKED_URI (
                sequence: 8
            )

            displayColumn COLUMN_NUMBER (
                sequence: 10
            )

            displayColumn CREATED (
                sequence: 14
            )

            displayColumn DISPOSITION (
                sequence: 7
            )

            displayColumn DOCUMENT_URI (
                sequence: 2
            )

            displayColumn EFFECTIVE_DIRECTIVE (
                sequence: 5
            )

            displayColumn ID (
                sequence: 1
            )

            displayColumn LINE_NUMBER (
                sequence: 9
            )

            displayColumn ORIGINAL_POLICY (
                sequence: 6
            )

            displayColumn REFERRER (
                sequence: 3
            )

            displayColumn SCRIPT_SAMPLE (
                sequence: 13
            )

            displayColumn SOURCE_FILE (
                sequence: 11
            )

            displayColumn STATUS_CODE (
                sequence: 12
            )

            displayColumn VIOLATED_DIRECTIVE (
                sequence: 4
            )

        )

    )

    button reset (
        buttonName: RESET
        label: Reset
        layout {
            sequence: 10
            region: @csp-report
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button reset-report (
        buttonName: RESET_REPORT
        label: リセット
        layout {
            sequence: 10
            region: @policy-violations
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: t-Button--iconLeft
            icon: fa-undo-alt
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 1
                action: resetRegions
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process reset (
        name: RESET
        type: executeCode
        source {
            plsqlCode: delete from ebaj_csp_reports;
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 12287539912271216
        }
        serverSideCondition {
            whenButtonPressed: @reset
        }
    )

)

