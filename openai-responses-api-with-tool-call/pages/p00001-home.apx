page 1 (
    name: ホーム
    alias: HOME
    title: OpenAI Responses API
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region annotations (
        name: Annotations
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select j.type, j.title, j.url, j.start_index, j.end_index
                from json_table(:P1_ANNOTATIONS, '$[*]'
                    columns
                    (
                        type        varchar2(20)  path '$.type',
                        title       varchar2(400) path '$.title',
                        url         varchar2(200) path '$.url',
                        start_index number        path '$.start_index',
                        end_index   number        path '$.end_index'
                    )
                ) j
                ```
        }
        layout {
            sequence: 90
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                    l_array json_array_t;
                begin
                    if :P1_ANNOTATIONS is not null then
                        l_array := json_array_t(:P1_ANNOTATIONS);
                        if l_array.get_size() > 0 then
                            return true;
                        end if;
                    end if;
                    return false;
                end;
                ```
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
        }
        pagination {
            type: nextAndPreviousLinks
        }

        column END_INDEX (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: End Index
                alignment: end
            }
            layout {
                sequence: 50
                columnAlignment: end
            }
        )

        column START_INDEX (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Start Index
                alignment: end
            }
            layout {
                sequence: 40
                columnAlignment: end
            }
        )

        column TITLE (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Title
            }
            layout {
                sequence: 20
            }
        )

        column TYPE (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Type
            }
            layout {
                sequence: 10
            }
        )

        column URL (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Url
            }
            layout {
                sequence: 30
            }
        )

    )

    region openai-responses-api (
        name: OpenAI Responses API
        type: staticContent
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/hero
            templateOptions: #DEFAULT#
        }
        image {
            fileUrl: #APP_FILES#icons/app-icon-512.png
        }
    )

    pageItem P1_ANNOTATIONS (
        type: hidden
        layout {
            sequence: 110
            slot: body
        }
    )

    pageItem P1_ERROR_CODE (
        type: textField
        label {
            label: Error Code
            alignment: left
        }
        layout {
            sequence: 150
            slot: body
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
        readOnly {
            type: always
        }
    )

    pageItem P1_ERROR_MESSAGE (
        type: textField
        label {
            label: Error Message
            alignment: left
        }
        layout {
            sequence: 160
            slot: body
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
        readOnly {
            type: always
        }
    )

    pageItem P1_INCOMPLETE_REASON (
        type: textField
        label {
            label: Incomplete Reason
            alignment: left
        }
        layout {
            sequence: 140
            slot: body
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
        readOnly {
            type: always
        }
    )

    pageItem P1_INPUT (
        type: textarea
        label {
            label: Input
            alignment: left
        }
        layout {
            sequence: 50
            slot: body
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 30
            height: 5
        }
    )

    pageItem P1_INSTRUCTIONS (
        type: textField
