    button clear (
        buttonName: CLEAR
        label: Clear
        layout {
            sequence: 70
            slot: body
            startNewRow: false
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--stretch
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button submit (
        buttonName: SUBMIT
        label: Submit
        layout {
            sequence: 60
            slot: body
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--stretch
            ]
        }
        behavior {
            showProcessing: true
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process call-openai-responses-api (
        name: Call OpenAI Responses API
        type: invokeApi
        invoke {
            type: plsqlProcedureOrFunction
            procedureOrFunction: OPENAI_RESPONSES_API
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 48155387774352723
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }

        parameter p_annotations (
            parameter {
                direction: out
                dataType: clob
            }
            value {
                item: P1_ANNOTATIONS
            }
            advanced {
                displaySequence: 70
            }
        )

        parameter p_credential_static_id (
            parameter {
                hasDefault: true
            }
            value {
                type: apiDefault
            }
            advanced {
                displaySequence: 90
            }
        )

        parameter p_endpoint (
            parameter {
                hasDefault: true
            }
            value {
                type: apiDefault
            }
            advanced {
                displaySequence: 80
            }
        )

        parameter p_error_code (
            parameter {
                direction: out
            }
            value {
                item: P1_ERROR_CODE
            }
            advanced {
                displaySequence: 130
            }
        )

        parameter p_error_message (
            parameter {
                direction: out
            }
            value {
                item: P1_ERROR_MESSAGE
            }
            advanced {
                displaySequence: 140
            }
        )

        parameter p_incomplete_reason (
            parameter {
                direction: out
            }
            value {
                item: P1_INCOMPLETE_REASON
            }
            advanced {
                displaySequence: 120
            }
        )

        parameter p_input (
            value {
                type: item
                item: P1_INPUT
            }
            advanced {
                displaySequence: 20
            }
        )

        parameter p_instructions (
            value {
                type: item
                item: P1_INSTRUCTIONS
            }
            advanced {
                displaySequence: 30
            }
        )

        parameter p_model (
            value {
                type: item
                item: P1_MODEL
            }
            advanced {
                displaySequence: 10
            }
        )

        parameter p_output_text (
            parameter {
                direction: out
                dataType: clob
            }
            value {
                item: P1_OUTPUT_TEXT
            }
            advanced {
                displaySequence: 40
            }
        )

        parameter p_refusal (
            parameter {
                direction: out
                dataType: clob
            }
            value {
                item: P1_REFUSAL
            }
            advanced {
                displaySequence: 100
            }
        )

        parameter p_response_id (
            parameter {
                direction: inOut
            }
            value {
                item: P1_RESPONSE_ID
            }
            advanced {
                displaySequence: 60
            }
        )

        parameter p_status (
            parameter {
                direction: out
            }
            value {
                item: P1_STATUS
            }
            advanced {
                displaySequence: 110
            }
        )

        parameter p_summary_text (
            parameter {
                direction: out
                dataType: clob
            }
            value {
                item: P1_SUMMARY_TEXT
            }
            advanced {
                displaySequence: 150
            }
        )

        parameter p_tool_set (
            parameter {
                hasDefault: true
            }
            value {
                type: item
                item: P1_TOOL_SET
            }
            advanced {
                displaySequence: 160
            }
        )

        parameter p_usage (
            parameter {
                direction: out
                dataType: clob
            }
            value {
                item: P1_USAGE
            }
            advanced {
                displaySequence: 50
            }
        )

    )

    process clear-session-state (
        name: Clear Session State
        type: clearSessionState
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 48156807086352738
        }
        serverSideCondition {
            whenButtonPressed: @clear
        }
    )

)

