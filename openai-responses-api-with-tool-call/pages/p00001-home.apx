        layout {
            sequence: 30
            slot: body
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P1_MODEL (
        type: selectList
        label {
            label: Model
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC2:gpt-6-astra;gpt-6-astra,gpt-6-sol;gpt-6-sol,gpt-6-luna;gpt-6-luna
            displayExtraValues: false
        }
        layout {
            sequence: 10
            slot: body
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            height: 1
        }
    )

    pageItem P1_OUTPUT_TEXT (
        type: markdownEditor
        label {
            label: Output Text
            alignment: left
        }
        layout {
            sequence: 80
            slot: body
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        sessionState {
            dataType: clob
        }
        readOnly {
            type: always
        }
    )

    pageItem P1_REFUSAL (
        type: markdownEditor
        label {
            label: Refusal
            alignment: left
