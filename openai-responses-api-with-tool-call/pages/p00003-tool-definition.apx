page 3 (
    name: Tool Definition
    alias: TOOL-DEFINITION
    title: Tool Definition
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/drawer
        templateOptions: [
            #DEFAULT#
            js-dialog-class-t-Drawer--pullOutEnd
        ]
    }
    dialog {
        chained: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region tool-definition (
        name: Tool Definition
        type: form
        source {
            location: localDatabase
            tableName: OPENAI_TOOLS
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    region ボタン (
        name: ボタン
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
    )

    pageItem P3_ALLOWED_CALLERS (
        type: textField
        label {
            label: Allowed Callers
            alignment: left
        }
        layout {
            sequence: 90
            region: @tool-definition
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
        source {
            formRegion: @tool-definition
            column: ALLOWED_CALLERS
            dataType: clob
        }
    )

    pageItem P3_ALLOWED_TOOLS (
        type: textarea
        label {
            label: Allowed Tools
            alignment: left
        }
        layout {
            sequence: 120
            region: @tool-definition
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 30
            height: 5
        }
        validation {
            maxLength: 4000
        }
        source {
            formRegion: @tool-definition
            column: ALLOWED_TOOLS
            dataType: varchar2
        }
    )

    pageItem P3_DESCRIPTION (
        type: textarea
        label {
            label: Description
            alignment: left
        }
        layout {
            sequence: 50
            region: @tool-definition
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 60
            height: 4
        }
        validation {
            maxLength: 4000
        }
        source {
            formRegion: @tool-definition
            column: DESCRIPTION
            dataType: varchar2
        }
    )

    pageItem P3_ID (
        type: hidden
        layout {
            sequence: 10
            region: @tool-definition
            slot: regionBody
        }
        source {
            formRegion: @tool-definition
            column: ID
            dataType: number
            queryOnly: true
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P3_OUTPUT_SCHEMA (
        type: textarea
        label {
            label: Output Schema
            alignment: left
        }
        layout {
            sequence: 80
            region: @tool-definition
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 60
            height: 5
        }
        source {
            formRegion: @tool-definition
            column: OUTPUT_SCHEMA
            dataType: clob
        }
    )

    pageItem P3_PARAMETERS (
        type: textarea
        label {
            label: Parameters
            alignment: left
        }
        layout {
            sequence: 70
            region: @tool-definition
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 60
            height: 4
        }
        source {
            formRegion: @tool-definition
            column: PARAMETERS
            dataType: clob
        }
        sessionState {
            dataType: clob
        }
    )

    pageItem P3_SERVER_LABEL (
        type: textField
        label {
            label: Server Label
            alignment: left
        }
        layout {
            sequence: 100
            region: @tool-definition
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            maxLength: 200
        }
        source {
            formRegion: @tool-definition
            column: SERVER_LABEL
            dataType: varchar2
        }
    )

    pageItem P3_SERVER_URL (
        type: textField
        label {
            label: Server Url
            alignment: left
        }
        layout {
            sequence: 110
            region: @tool-definition
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            maxLength: 200
        }
        source {
            formRegion: @tool-definition
            column: SERVER_URL
            dataType: varchar2
        }
    )

    pageItem P3_TOOL_NAME (
        type: textField
        label {
            label: Tool Name
            alignment: left
        }
        layout {
            sequence: 40
            region: @tool-definition
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 80
        }
        source {
            formRegion: @tool-definition
            column: TOOL_NAME
            dataType: varchar2
        }
    )

    pageItem P3_TOOL_SET (
        type: textField
        label {
            label: Tool Set
            alignment: right
        }
        layout {
            sequence: 20
            region: @tool-definition
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
            maxLength: 20
        }
        source {
            formRegion: @tool-definition
            column: TOOL_SET
            dataType: varchar2
        }
    )

    pageItem P3_TOOL_TYPE (
        type: textField
        label {
            label: Tool Type
            alignment: right
        }
        layout {
            sequence: 30
            region: @tool-definition
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
            maxLength: 20
        }
        source {
            formRegion: @tool-definition
            column: TOOL_TYPE
            dataType: varchar2
        }
    )

    button cancel (
        buttonName: CANCEL
        label: 取消
        layout {
            sequence: 10
            region: @ボタン
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: triggerAction
        }

        triggerAction native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
            }
        )

    )

    button create (
        buttonName: CREATE
        label: 作成
        layout {
            sequence: 40
            region: @ボタン
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P3_ID
        }
    )

    button delete (
        buttonName: DELETE
        label: 削除
        layout {
            sequence: 20
            region: @ボタン
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P3_ID
        }
    )

    button save (
        buttonName: SAVE
        label: 変更の適用
        layout {
            sequence: 30
            region: @ボタン
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P3_ID
        }
    )

    process ダイアログを閉じる (
        name: ダイアログを閉じる
        type: closeDialog
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 19558901006646805
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

    process プロセス-フォームtool-definition (
        name: プロセス・フォームTool Definition
        type: formAutoRowProcessing
        formRegion: @tool-definition
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 19558540948646805
        }
    )

    process 初期化フォームtool-definition (
        name: 初期化フォームTool Definition
        type: formInitialization
        formRegion: @tool-definition
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 19558157625646804
        }
    )

)

