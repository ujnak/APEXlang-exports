page 2 (
    name: Tool Definitions
    alias: TOOL-DEFINITIONS
    title: Tool Definitions
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region tool-definitions (
        name: Tool Definitions
        type: interactiveReport
        source {
            location: localDatabase
            tableName: OPENAI_TOOLS
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
        link {
            linkColumn: customTarget
            target: {
                page: 3
                items: {
                    P3_ID: \#ID#\
                }
                action: resetPagination
            }
            linkIcon: <span role="img" aria-label="&#x7DE8;&#x96C6;" class="fa fa-edit" title="&#x7DE8;&#x96C6;"></span>
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: データが見つかりません。
            whenMoreDataFound: このレポートの最大行数は#MAX_ROW_COUNT#行です。フィルタを適用して、問合せのレコード数を削減してください。
        }
        advanced {
            savedReportMappingIdentifier: 19560122979646863
        }

        column ALLOWED_CALLERS (
            type: plainText
            heading {
                heading: Allowed Callers
            }
            layout {
                sequence: 17
            }
            source {
                dataType: CLOB
            }
            columnFilter {
                type: none
            }
            advanced {
                endUserAlias: H
            }
            enableUsersTo {
                sort: false
                controlBreak: false
                aggregate: false
                compute: false
                chart: false
                groupBy: false
                pivot: false
            }
        )

        column ALLOWED_TOOLS (
            type: plainText
            heading {
                heading: Allowed Tools
            }
            layout {
                sequence: 47
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: K
            }
        )

        column DESCRIPTION (
            type: plainText
            heading {
                heading: Description
            }
            layout {
                sequence: 4
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: D
            }
        )

        column ID (
            type: hidden
            heading {
                heading: ID
            }
            layout {
                sequence: 0
            }
            source {
                primaryKey: true
                dataType: NUMBER
            }
            advanced {
                endUserAlias: A
            }
        )

        column OUTPUT_SCHEMA (
            type: plainText
            heading {
                heading: Output Schema
            }
            layout {
                sequence: 7
            }
            source {
                dataType: CLOB
            }
            columnFilter {
                type: none
            }
            advanced {
                endUserAlias: G
            }
            enableUsersTo {
                hide: false
                highlight: false
                controlBreak: false
                aggregate: false
                compute: false
                chart: false
                groupBy: false
            }
        )

        column PARAMETERS (
            type: plainText
            heading {
                heading: Parameters
            }
            layout {
                sequence: 6
            }
            source {
                dataType: CLOB
            }
            columnFilter {
                type: none
            }
            advanced {
                endUserAlias: F
            }
            enableUsersTo {
                hide: false
                highlight: false
                controlBreak: false
                aggregate: false
                compute: false
                chart: false
                groupBy: false
            }
        )

        column SERVER_LABEL (
            type: plainText
            heading {
                heading: Server Label
            }
            layout {
                sequence: 27
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: I
            }
        )

        column SERVER_URL (
            type: plainText
            heading {
                heading: Server Url
            }
            layout {
                sequence: 37
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: J
            }
        )

        column TOOL_NAME (
            type: plainText
            heading {
                heading: Tool Name
            }
            layout {
                sequence: 5
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: E
            }
        )

        column TOOL_SET (
            type: plainText
            heading {
                heading: Tool Set
            }
            layout {
                sequence: 2
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: B
            }
        )

        column TOOL_TYPE (
            type: plainText
            heading {
                heading: Tool Type
            }
            layout {
                sequence: 3
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: C
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }

        savedReport primary (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn DESCRIPTION (
                sequence: 4
            )

            displayColumn ID (
                sequence: 1
            )

            displayColumn OUTPUT_SCHEMA (
                sequence: 7
            )

            displayColumn PARAMETERS (
                sequence: 6
            )

            displayColumn TOOL_NAME (
                sequence: 5
            )

            displayColumn TOOL_SET (
                sequence: 2
            )

            displayColumn TOOL_TYPE (
                sequence: 3
            )

        )

    )

    region ブレッドクラム (
        name: ブレッドクラム
        type: breadcrumb
        source {
            breadcrumb: @ブレッドクラム
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    button create (
        buttonName: CREATE
        label: 作成
        layout {
            sequence: 10
            region: @tool-definitions
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 3
                clearCache: 3
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction レポートの編集-ダイアログのクローズ (
        name: レポートの編集 - ダイアログのクローズ
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @tool-definitions
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @tool-definitions
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

