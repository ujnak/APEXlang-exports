page 1 (
    name: ホーム
    alias: HOME
    title: Salary Management Agent
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region chat (
        name: Chat
        type: staticContent
        source {
            htmlCode: <div id="chat"></div>
        }
        layout {
            sequence: 20
            slot: body
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
    )

    region employees (
        name: Employees
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
    )

    region employees_1 (
        name: Employees
        type: classicReport
        source {
            location: localDatabase
            tableName: EMP
        }
        layout {
            sequence: 30
            parentRegion: @employees
            slot: regionBody
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
        advanced {
            htmlDomId: EMP
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
        }

        column COMM (
            reportColumnQueryId: 7
            derivedColumn: N
            heading {
                heading: Comm
                alignment: end
            }
            layout {
                sequence: 70
                columnAlignment: end
            }
        )

        column DEPTNO (
            reportColumnQueryId: 8
            derivedColumn: N
            heading {
                heading: Deptno
                alignment: end
            }
            layout {
                sequence: 80
                columnAlignment: end
            }
        )

        column EMPNO (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Empno
                alignment: end
            }
            layout {
                sequence: 10
                columnAlignment: end
            }
        )

        column ENAME (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Ename
            }
            layout {
                sequence: 20
            }
        )

        column HIREDATE (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Hiredate
            }
            layout {
                sequence: 50
            }
        )

        column JOB (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Job
            }
            layout {
                sequence: 30
            }
        )

        column MGR (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Mgr
                alignment: end
            }
            layout {
                sequence: 40
                columnAlignment: end
            }
        )

        column SAL (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Sal
                alignment: end
            }
            layout {
                sequence: 60
                columnAlignment: end
            }
        )

    )

    region salary-management-agent (
        name: Salary Management Agent
        type: staticContent
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/hero
            templateOptions: #DEFAULT#
        }
        image {
            fileUrl: #APP_FILES#icons/app-icon-512.png
        }
    )

    pageItem P1_ENAME (
        type: selectList
        label {
            label: Ename
            alignment: left
        }
        settings {
            pageActionOnSelection: redirectSetValue
        }
        lov {
            type: sqlQuery
            sqlQuery: select ename d, ename r from emp order by 1
        }
        layout {
            sequence: 20
            region: @employees
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            height: 1
        }
    )

    dynamicAction onload-chat (
        name: onLoad Chat
        execution {
            sequence: 10
        }
        when {
            event: ready
        }

        action native-open-ai-assistant (
            action: showAiAssistant
            genAI {
                agent: @salary-management-agent
            }
            appearance {
                displayAs: inline
                containerSelector: #chat
            }
            execution {
                sequence: 10
            }
        )

    )

)

