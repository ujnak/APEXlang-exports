page 5 (
    name: Employees - WebMCP
    alias: EMPLOYEES-WEBMCP
    title: Employees - WebMCP
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region employees-webmcp (
        name: Employees - WebMCP
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select
                    e.empno,
                    e.ename,
                    e.job,
                    e.mgr,
                    e.hiredate,
                    e.sal,
                    e.comm,
                    e.deptno
                from emp e
                where (:P5_ENAME is null or e.ename = :P5_ENAME)
                  and (
                    :P5_DNAME is null
                    or exists (
                        select 1
                        from dept d
                        where d.deptno = e.deptno
                            and d.dname = :P5_DNAME
                    )
                )
                ```
            pageItemsToSubmit: [
                P5_ENAME
                P5_DNAME
            ]
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
            ]
        }
        advanced {
            htmlDomId: employees-report
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--staticRowColors
                t-Report--rowHighlight
                t-Report--inline
                t-Report--hideNoPagination
            ]
        }
        messages {
            whenNoDataFound: データが見つかりません。
        }

        column COMM (
            reportColumnQueryId: 7
            derivedColumn: N
            heading {
                heading: Commission
                alignment: end
            }
            layout {
                sequence: 7
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G999G999G999G999G999G990
            }
        )

        column DEPTNO (
            reportColumnQueryId: 8
            derivedColumn: N
            type: plainTextBasedOnLov
            heading {
                heading: Deptno
            }
            lov {
                type: sharedComponent
                lov: @dept-dname
            }
            layout {
                sequence: 8
            }
            sorting {
                defaultSequence: 1
            }
        )

        column EMPNO (
            reportColumnQueryId: 1
            derivedColumn: N
            type: link
            heading {
                alignment: center
            }
            layout {
                sequence: 0
                columnAlignment: center
            }
            link {
                target: {
                    page: 6
                    items: {
                        P6_EMPNO: \#EMPNO#\
                    }
                    action: resetPagination
                }
                linkText: <span role="img" aria-label="&#x7DE8;&#x96C6;" class="fa fa-edit" title="&#x7DE8;&#x96C6;"></span>
            }
            sorting {
                sortable: false
            }
        )

        column ENAME (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Employee Name
            }
            layout {
                sequence: 2
            }
            sorting {
                defaultSequence: 1
            }
        )

        column HIREDATE (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Hired
            }
            layout {
                sequence: 5
            }
        )

        column JOB (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Job
            }
            layout {
                sequence: 3
            }
            sorting {
                defaultSequence: 1
            }
        )

        column MGR (
            reportColumnQueryId: 4
            derivedColumn: N
            type: plainTextBasedOnLov
            heading {
                heading: Manager
            }
            lov {
                type: sharedComponent
                lov: @emp-ename
            }
            layout {
                sequence: 4
            }
            sorting {
                defaultSequence: 1
            }
        )

        column SAL (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Salary
                alignment: end
            }
            layout {
                sequence: 6
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G999G999G999G999G999G990
            }
        )

    )

    region webmcp-search-tool (
        name: WebMCP Search Tool
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
    )

    region ブレッドクラム (
        name: ブレッドクラム
        type: breadcrumb
        source {
            breadcrumb: @ブレッドクラム
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    pageItem P5_DNAME (
        type: textField
        label {
            label: Dname
            alignment: left
        }
        layout {
            sequence: 20
            region: @webmcp-search-tool
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
        advanced {
            warnOnUnsavedChanges: ignore
        }
        sessionState {
            storage: request
        }
    )

    pageItem P5_ENAME (
        type: textField
        label {
            label: Ename
            alignment: left
        }
        layout {
            sequence: 10
            region: @webmcp-search-tool
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
        advanced {
            warnOnUnsavedChanges: ignore
        }
        sessionState {
            storage: request
        }
    )

    button create (
        buttonName: CREATE
        label: 作成
        layout {
            sequence: 10
            region: @employees-webmcp
            slot: edit
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 6
                clearCache: 6
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button search (
        buttonName: SEARCH
        label: Search
        layout {
            sequence: 30
            region: @webmcp-search-tool
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: triggerAction
        }

        triggerAction native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @employees-webmcp
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction register-webmcp-tools (
        name: Register WebMCP Tools
        execution {
            sequence: 10
        }
        when {
            event: ready
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    (async () => {
                      await document.modelContext.registerTool({
                        name: 'search_employees',
                        description: 'Lists employee information according to the specified conditions.',
                        inputSchema: {
                          type: 'object',
                          properties: {
                            ename: {
                                type: 'string',
                                description: 'Employee name to search for'
                            },
                            dname: {
                                type: 'string',
                                description: 'Department to which the employee belongs' 
                            }
                          }
                        },
                        execute: async ({ ename,dname }) => {
                          try {
                            apex.item('P5_ENAME').setValue(ename ?? '');
                            apex.item('P5_DNAME').setValue(dname ?? '');
                            apex.region('employees-report').refresh();
                    
                            return await apex.server.process(
                              'SEARCH_EMPLOYEES',
                              {
                                pageItems: [
                                    'P5_ENAME',
                                    'P5_DNAME'
                                ]
                              }
                            );
                          } catch (error) {
                            return {
                              success: false,
                              errorCode: 'REQUEST_ERROR',
                              message: error.message || 'Employee search request failed.'
                            };
                          }
                        }
                      });
                    })();
                    ```
            }
            execution {
                sequence: 10
            }
        )

    )

    process search-employees (
        name: SEARCH_EMPLOYEES
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  l_result json_object_t := json_object_t();
                  l_employees clob;
                begin
                    select json_arrayagg(
                        json_object(
                            'EMPNO'    value e.empno,
                            'ENAME'    value e.ename,
                            'JOB'      value e.job,
                            'MGR'      value e.mgr,
                            'HIREDATE' value to_char(e.hiredate,'YYYY/MM/DD'),
                            'SAL'      value e.sal,
                            'COMM'     value e.comm,
                            'DEPTNO'   value e.deptno,
                            'FORM_URL' value apex_page.get_url(
                                p_page      => 6,
                                p_clear_cache => '6',
                                p_items     => 'P6_EMPNO',
                                p_values    => e.empno,
                                p_plain_url => true
                            )
                            returning clob
                        )
                        returning clob
                    )
                into l_employees
                from emp e
                where (:P5_ENAME is null or e.ename = :P5_ENAME)
                  and (
                    :P5_DNAME is null
                    or exists (
                        select 1
                        from dept d
                        where d.deptno = e.deptno
                            and d.dname = :P5_DNAME
                    )
                );
                
                l_result := json_object_t();
                l_result.put('success', true);
                if l_employees is null then
                    l_result.put('search_result', json_array_t());
                else
                    l_result.put('search_result', json_array_t(l_employees));
                end if;
                
                htp.p(l_result.to_clob());
                
                exception
                    when others then
                        l_result := json_object_t();
                        l_result.put('success', false);
                        l_result.put('message', sqlerrm);
                
                        htp.p(l_result.to_clob());
                end;
                ```
        }
        execution {
            sequence: 10
            point: ajaxCallback
        }
        advanced {
            executionMappingIdentifier: 11210057828536819
        }
    )

)

