    button cancel (
        buttonName: CANCEL
        label: 取消
        layout {
            sequence: 10
            region: @employee
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 1
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button create (
        buttonName: CREATE
        label: 作成
        layout {
            sequence: 40
            region: @employee
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P2_EMPNO
        }
    )

    button delete (
        buttonName: DELETE
        label: 削除
        layout {
            sequence: 20
            region: @employee
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P2_EMPNO
        }
    )

    button save (
        buttonName: SAVE
        label: 変更の適用
        layout {
            sequence: 30
            region: @employee
            slot: change
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P2_EMPNO
        }
    )

    dynamicAction register-webmcp-tool (
        name: Register WebMCP Tool
        execution {
            sequence: 10
        }
        when {
            event: ready
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    const formElement = document.querySelector('#wwvFlowForm');
                    
                    formElement.setAttribute('toolname', 'register_employee');
                    formElement.setAttribute('tooldescription', '従業員を登録します。');
                    // Comment out the next line when a user should review the form and submit it manually.
                    formElement.setAttribute('toolautosubmit', '');
                    
                    formElement.addEventListener('submit', (event) => {
                      // Human submission: retain the existing APEX Automatic DML flow.
                      if (!event.agentInvoked) {
                        return;
                      }
                    
                      // WebMCP submission: prevent both native submission and APEX handlers.
                      event.preventDefault();
                      event.stopImmediatePropagation();
                    
                      const result = (async () => {
                        try {
                          return await apex.server.process(
                            'REGISTER_EMPLOYEE',
                            {
                              pageItems: [
                                'P2_EMPNO',
                                'P2_ENAME',
                                'P2_JOB',
                                'P2_MGR',
                                'P2_HIREDATE',
                                'P2_SAL',
                                'P2_COMM',
                                'P2_DEPTNO'
                              ]
                            }
                          );
                        } catch (error) {
                          return {
                            success: false,
                            errorCode: 'REQUEST_ERROR',
                            message: error.message || 'Employee registration request failed.'
                          };
                        }
                      })();
                    
                      event.respondWith(result);
                    }, true);
                    ```
            }
            execution {
                sequence: 10
            }
        )

    )

    process register-employee (
        name: REGISTER_EMPLOYEE
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  l_empno   emp.empno%type;
                  l_result  json_object_t;
                begin
                  insert into emp (
                    empno,
                    ename,
                    job,
                    mgr,
                    hiredate,
                    sal,
                    comm,
                    deptno
                  )
                  values (
                    :P2_EMPNO,
                    upper(:P2_ENAME),
                    :P2_JOB,
                    :P2_MGR,
                    :P2_HIREDATE,
                    :P2_SAL,
                    :P2_COMM,
                    :P2_DEPTNO
                  )
                  returning empno into l_empno;
                
                  l_result := json_object_t();
                  l_result.put('success', true);
                  l_result.put('empno', l_empno);
                  l_result.put('message', 'Employee registered successfully.');
                
                  htp.p(l_result.to_clob());
                
                exception
                  when others then
                    l_result := json_object_t();
                    l_result.put('success', false);
                    l_result.put('message', sqlerrm);
                
                    htp.p(l_result.to_clob());
                end;
                ```
        }
        execution {
            sequence: 10
            point: ajaxCallback
        }
        advanced {
            executionMappingIdentifier: 9402864144112921
        }
    )

    process プロセス-フォームemployee (
        name: プロセス・フォームEmployee
        type: formAutoRowProcessing
        formRegion: @employee
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 10433347476868172
        }
    )

    process 初期化フォームemployee (
        name: 初期化フォームEmployee
        type: formInitialization
        formRegion: @employee
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 10432976874868171
        }
    )

    branch (
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 1
            }
        }
    )

)

