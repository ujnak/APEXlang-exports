            sequence: 10
            region: @employee
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
        advanced {
            customAttributes: toolparamdescription="従業員番号"
        }
        source {
            formRegion: @employee
            column: EMPNO
            dataType: number
            queryOnly: true
            primaryKey: true
        }
