            sequence: 40
            region: @employee
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        advanced {
            customAttributes: toolparamdescription="マネージャーの従業員番号"
        }
        source {
            formRegion: @employee
            column: MGR
