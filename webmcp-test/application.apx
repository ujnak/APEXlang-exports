app WEBMCP-TEST (
    name: WebMCP Test
    logo {
        type: text
        text: WebMCP Test
    }
    navigation {
        homeUrl: {
            page: 1
        }
        loginUrl: {
            page: LOGIN
        }
    }
    navigationMenu {
        listTemplate: @/side-navigation-menu
        templateOptions: [
            #DEFAULT#
            t-TreeNav--styleA
            js-navCollapsed--hidden
        ]
        list: @ナビゲーション-メニュー
    }
    navigationBar {
        list: @ナビゲーション-バー
        listTemplate: @/navigation-bar
        templateOptions: #DEFAULT#
    }
    userInterface {
        currentTheme: @universal-theme
        globalPage: 0
        addBuiltWithApexToFooter: false
    }
    appFormatMasks {
        date: DS
        timestamp: DS
        timestampTimeZone: DS
    }
    authentication {
        scheme: @oracle-apexアカウント
    }
    sessionStateProtection {
        checksumSalt: 750A27B93D11E7DF30D1374CF27E51097DE9F149090B8464E1D2E29C71258BCA
    }
    globalization {
        primaryLanguage: ja
    }
    runtime {
        allowFeedback: true
    }

    substitution APP_NAME (
        value {
            staticValue: WebMCP Test
        }
    )

)

