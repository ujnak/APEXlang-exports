app GET-TABLE-INFO-BY-APEX-DB-DICTIONARY (
    name: Get Table Info by APEX_DB_DICTIONARY
    logo {
        type: text
        text: Get Table Info by APEX_DB_DICTIONARY
    }
    navigation {
        homeUrl: {
            page: 1
        }
        loginUrl: {
            page: LOGIN
        }
    }
    navigationMenu {
        listTemplate: @/side-navigation-menu
        templateOptions: [
            #DEFAULT#
            t-TreeNav--styleA
            js-navCollapsed--hidden
        ]
        list: @ナビゲーション-メニュー
    }
    navigationBar {
        list: @ナビゲーション-バー
        listTemplate: @/navigation-bar
        templateOptions: #DEFAULT#
    }
    userInterface {
        currentTheme: @universal-theme
        globalPage: 0
        addBuiltWithApexToFooter: false
    }
    appFormatMasks {
        date: DS
        timestamp: DS
        timestampTimeZone: DS
    }
    authentication {
        scheme: @oracle-apexアカウント
    }
    sessionStateProtection {
        checksumSalt: F9EB31A42C98C58CAB45B8C133B4C5B2A71E6A9AED667B227B30CD33110FDE8D
    }
    globalization {
        primaryLanguage: ja
    }
    runtime {
        allowFeedback: true
    }

    substitution APP_NAME (
        value {
            staticValue: Get Table Info by APEX_DB_DICTIONARY
        }
    )

)

