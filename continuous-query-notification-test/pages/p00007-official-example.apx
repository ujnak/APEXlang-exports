            )

        )

    )

    region ブレッドクラム (
        name: ブレッドクラム
        type: breadcrumb
        source {
            breadcrumb: @ブレッドクラム
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    button reset (
        buttonName: RESET
        label: Reset
        layout {
            sequence: 10
            region: @ブレッドクラム
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: triggerAction
            requiresConfirmation: true
        }
        confirmation {
            message: 本当に削除しますか？
            style: danger
        }

        triggerAction native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    delete from nfevents;
                    delete from nfqueries;
                    delete from nftablechanges;
                    delete from nfrowchanges;
                    ```
            }
            execution {
                sequence: 10
            }
        )

        triggerAction native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @nfevents
            }
            execution {
                sequence: 20
            }
        )

        triggerAction native-refresh_1 (
            action: refresh
            affectedElements {
                selectionType: region
                region: @nfqueries
            }
            execution {
                sequence: 30
            }
        )

        triggerAction native-refresh_1_1 (
            action: refresh
            affectedElements {
                selectionType: region
                region: @nftablechanges
            }
            execution {
                sequence: 40
            }
        )

        triggerAction native-refresh_1_1_1 (
            action: refresh
            affectedElements {
                selectionType: region
                region: @nfrowchanges
            }
            execution {
                sequence: 50
            }
        )

    )

)

