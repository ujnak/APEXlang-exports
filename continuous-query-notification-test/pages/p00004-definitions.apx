page 4 (
    name: Definitions
    alias: DEFINITIONS
    title: Definitions
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region definitions (
        name: Definitions
        type: interactiveReport
        source {
            location: localDatabase
            tableName: TCQ_NOTIFICATION_DEFS
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
        link {
            linkColumn: customTarget
            target: {
                page: 5
                items: {
                    P5_ID: \#ID#\
                }
                action: resetPagination
            }
            linkIcon: <span role="img" aria-label="&#x7DE8;&#x96C6;" class="fa fa-edit" title="&#x7DE8;&#x96C6;"></span>
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: データが見つかりません。
            whenMoreDataFound: このレポートの最大行数は#MAX_ROW_COUNT#行です。フィルタを適用して、問合せのレコード数を削減してください。
        }
        advanced {
            savedReportMappingIdentifier: 10845659509035712
        }

        column ID (
            type: hidden
            heading {
                heading: ID
            }
            layout {
                sequence: 0
            }
            source {
                primaryKey: true
                dataType: NUMBER
            }
            advanced {
                endUserAlias: A
            }
        )

        column OWNER (
            type: plainText
            heading {
                heading: Owner
            }
            layout {
                sequence: 2
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: B
            }
        )

        column QUERY_ID_COMM (
            type: plainText
            heading {
                heading: Query Id Comm
                alignment: end
            }
            layout {
                sequence: 5
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: E
            }
        )

        column QUERY_ID_SAL (
            type: plainText
            heading {
                heading: Query Id Sal
                alignment: end
            }
            layout {
                sequence: 4
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: D
            }
        )

        column REG_ID (
            type: plainText
            heading {
                heading: Reg ID
                alignment: end
            }
            layout {
                sequence: 3
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: C
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }

        savedReport primary (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn ID (
                sequence: 1
            )

            displayColumn OWNER (
                sequence: 2
            )

            displayColumn QUERY_ID_COMM (
                sequence: 5
            )

            displayColumn QUERY_ID_SAL (
                sequence: 4
            )

            displayColumn REG_ID (
                sequence: 3
            )

        )

    )

    region user-change-notification-regs (
        name: USER_CHANGE_NOTIFICATION_REGS
        type: interactiveReport
        source {
            location: localDatabase
            tableName: USER_CHANGE_NOTIFICATION_REGS
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--scrollBody
            ]
        }
        pagination {
            type: rowRangesXToY
        }
        advanced {
            savedReportMappingIdentifier: 10853315439040408
        }

        column CALLBACK (
            type: plainText
            heading {
                heading: Callback
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: C
            }
        )

        column CHANGELAG (
            type: plainText
            heading {
                heading: Changelag
                alignment: end
            }
            layout {
                sequence: 50
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: E
            }
        )

        column OPERATIONS_FILTER (
            type: plainText
            heading {
                heading: Operations Filter
                alignment: end
            }
            layout {
                sequence: 40
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: D
            }
        )

        column REGFLAGS (
            type: plainText
            heading {
                heading: Regflags
                alignment: end
            }
            layout {
                sequence: 20
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: B
            }
        )

        column REGID (
            type: plainText
            heading {
                heading: Regid
                alignment: end
            }
            layout {
                sequence: 10
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: A
            }
        )

        column TABLE_NAME (
            type: plainText
            heading {
                heading: Table Name
            }
            layout {
                sequence: 70
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: G
            }
        )

        column TIMEOUT (
            type: plainText
            heading {
                heading: Timeout
                alignment: end
            }
            layout {
                sequence: 60
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: F
            }
        )

        page {
            size: a4
            units: millimeters
            width: 297
            height: 210
            borderWidth: 0.5
            borderColor: #666666
        }

        savedReport primary (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn CALLBACK (
                sequence: 3
            )

            displayColumn CHANGELAG (
                sequence: 5
            )

            displayColumn OPERATIONS_FILTER (
                sequence: 4
            )

            displayColumn REGFLAGS (
                sequence: 2
            )

            displayColumn REGID (
                sequence: 1
            )

            displayColumn TABLE_NAME (
                sequence: 7
            )

            displayColumn TIMEOUT (
                sequence: 6
            )

        )

    )

    region user-cq-notification-queries (
        name: USER_CQ_NOTIFICATION_QUERIES
        type: interactiveReport
        source {
            location: localDatabase
            tableName: USER_CQ_NOTIFICATION_QUERIES
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--scrollBody
            ]
        }
        pagination {
            type: rowRangesXToY
        }
        advanced {
            savedReportMappingIdentifier: 10854207106040417
        }

        column QUERYID (
            type: plainText
            heading {
                heading: Queryid
                alignment: end
            }
            layout {
                sequence: 10
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: A
            }
        )

        column QUERYTEXT (
            type: plainText
            heading {
                heading: Querytext
            }
            layout {
                sequence: 20
            }
            source {
                dataType: CLOB
            }
            columnFilter {
                type: none
            }
            advanced {
                endUserAlias: B
            }
            enableUsersTo {
                sort: false
                controlBreak: false
                aggregate: false
                compute: false
                chart: false
                groupBy: false
                pivot: false
            }
        )

        column REGID (
            type: plainText
            heading {
                heading: Regid
                alignment: end
            }
            layout {
                sequence: 30
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: C
            }
        )

        page {
            size: a4
            units: millimeters
            width: 297
            height: 210
            borderWidth: 0.5
            borderColor: #666666
        }

        savedReport primary (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn QUERYID (
                sequence: 1
            )

            displayColumn QUERYTEXT (
                sequence: 2
            )

            displayColumn REGID (
                sequence: 3
            )

        )

    )

    region ブレッドクラム (
        name: ブレッドクラム
        type: breadcrumb
        source {
            breadcrumb: @ブレッドクラム
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    button create (
        buttonName: CREATE
        label: 作成
        layout {
            sequence: 10
            region: @definitions
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 5
                clearCache: 5
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction レポートの編集-ダイアログのクローズ (
        name: レポートの編集 - ダイアログのクローズ
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @definitions
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @definitions
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-refresh_1 (
            action: refresh
            affectedElements {
                selectionType: region
                region: @user-change-notification-regs
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-refresh_1_1 (
            action: refresh
            affectedElements {
                selectionType: region
                region: @user-cq-notification-queries
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

    )

)

