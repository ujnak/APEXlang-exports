            }
        )

        column RESTRICTIONS (
            reportColumnQueryId: 10
            derivedColumn: N
            heading {
                heading: 制限事項
            }
            layout {
                sequence: 100
            }
            comments {
                comments: 国土地理院GeoJSONの制限事項を表示。編集機能なし。
            }
        )

        column REVISION_DATES (
            reportColumnQueryId: 9
            derivedColumn: N
            heading {
                heading: 修正等公開日
            }
            layout {
                sequence: 90
            }
            comments {
                comments: 国土地理院GeoJSONの修正等公開日を表示。編集機能なし。
            }
        )

        column TRADITION_CONTENT (
            reportColumnQueryId: 7
            derivedColumn: N
            heading {
                heading: 伝承内容
            }
            layout {
                sequence: 70
            }
            comments {
                comments: 国土地理院GeoJSONの伝承内容を表示。編集機能なし。
            }
        )

    )

    region MONUMENT_MAP (
        name: 自然災害伝承碑
        type: map
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select MONUMENT_ID, MONUMENT_NAME, ESTABLISHED_YEAR, LOCATION, DISASTER_NAME, DISASTER_TYPE, TRADITION_CONTENT, to_char(PUBLISHED_DATE,'YYYY/MM/DD') PUBLISHED_DATE, REVISION_DATES, RESTRICTIONS, LONGITUDE, LATITUDE, GEOMETRY from NDMM_MONUMENTS
                where (:P1_SOUTH is null or LATITUDE between to_number(:P1_SOUTH) and to_number(:P1_NORTH))
                and (:P1_WEST is null or
                 (to_number(:P1_WEST) <= to_number(:P1_EAST) and LONGITUDE between to_number(:P1_WEST) and to_number(:P1_EAST)) or
                 (to_number(:P1_WEST) > to_number(:P1_EAST) and (LONGITUDE >= to_number(:P1_WEST) or LONGITUDE <= to_number(:P1_EAST))))
                            
                ```
            pageItemsToSubmit: [
                P1_WEST
                P1_EAST
                P1_SOUTH
                P1_NORTH
            ]
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: MONUMENT_MAP
        }
        map {
            height: 560
        }
        controls {
            options: [
                mousewheelZoom
                scaleBar
            ]
        }
        legend {
            show: false
        }
        performance {
            lazyLoading: false
        }

        layer monuments (
            name: 自然災害伝承碑
            layout {
                sequence: 10
            }
            source {
                location: regionSource
                useSpatialIndex: true
            }
            columnMapping {
                geometryColumn: GEOMETRY
                primaryKeyColumn: MONUMENT_ID
            }
            tooltip {
                column: MONUMENT_NAME
            }
            infoWindow {
                advancedFormatting: true
                htmlExpression:
                    ```html
                    <div class="ndmm-info-window"><dl>
                    <dt><strong>ID</strong></dt><dd>&MONUMENT_ID!HTML.</dd>
                    <dt><strong>碑名</strong></dt><dd>&MONUMENT_NAME!HTML.</dd>
                    <dt><strong>建立年</strong></dt><dd>&ESTABLISHED_YEAR!HTML.</dd>
                    <dt><strong>所在地</strong></dt><dd>&LOCATION!HTML.</dd>
                    <dt><strong>災害名</strong></dt><dd>&DISASTER_NAME!HTML.</dd>
                    <dt><strong>災害種別</strong></dt><dd>&DISASTER_TYPE!HTML.</dd>
                    <dt><strong>伝承内容</strong></dt><dd>&TRADITION_CONTENT!HTML.</dd>
                    <dt><strong>公開日</strong></dt><dd>&PUBLISHED_DATE!HTML.</dd>
                    <dt><strong>修正等公開日</strong></dt><dd>&REVISION_DATES!HTML.</dd>
                    <dt><strong>制限事項</strong></dt><dd>&RESTRICTIONS!HTML.</dd>
                    <dt><strong>経度</strong></dt><dd>&LONGITUDE!HTML.</dd>
                    <dt><strong>緯度</strong></dt><dd>&LATITUDE!HTML.</dd>
                    
                    </dl></div>
                    ```
            }
        )

    )

    region TITLE (
        name: 自然災害伝承碑マップ
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: TITLE
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
        }
    )

    pageItem P1_EAST (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 20
            slot: body
        }
    )

    pageItem P1_NORTH (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 40
            slot: body
        }
    )

    pageItem P1_SOUTH (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 30
            slot: body
        }
    )

    pageItem P1_WEST (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            slot: body
        }
    )

)

