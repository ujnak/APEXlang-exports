                comments: 国土地理院GeoJSONの所在地を表示。編集機能なし。
            }
        )

        column LONGITUDE (
            reportColumnQueryId: 11
            derivedColumn: N
            heading {
                heading: 経度
            }
            layout {
                sequence: 110
