page 1 (
    name: 自然災害伝承碑マップ
    alias: HOME
    title: 自然災害伝承碑マップ
    appearance {
        pageTemplate: @/left-side-column
        templateOptions: #DEFAULT#
    }
    javaScript {
        executeWhenPageLoads:
            ```javascript-browser
            (function () {
                let timer;
                let lastBounds;
                let mapReady = false;
                function updateList() {
                    clearTimeout(timer);
                    timer = setTimeout(function () {
                        const region = apex.region('MONUMENT_MAP');
                        const map = region && region.getMapObject();
                        if (!map || !mapReady) return;
                        const b = map.getBounds();
                        let west = b.getWest(), east = b.getEast();
                        if (east-west >= 360) { west=-180; east=180; }
                        else { west=((west+180)%360+360)%360-180; east=((east+180)%360+360)%360-180; }
                        const bounds = [west, east, b.getSouth(), b.getNorth()].map(value => value.toFixed(6));
                        const boundsKey = bounds.join(',');
                        const boundsChanged = boundsKey !== lastBounds;
                        lastBounds = boundsKey;
                        apex.item('P1_WEST').setValue(bounds[0], null, true);
                        apex.item('P1_EAST').setValue(bounds[1], null, true);
                        apex.item('P1_SOUTH').setValue(bounds[2], null, true);
                        apex.item('P1_NORTH').setValue(bounds[3], null, true);
                        if (boundsChanged) {
                            region.refresh();
                            apex.region('FACETS').fetchCounts();
                        }
                        apex.region('MONUMENT_LIST').refresh();
                    }, 250);
                }
                function mapInitialized() {
                    mapReady = true;
                    updateList();
                }
                apex.jQuery('#MONUMENT_MAP').on('spatialmapinitialized', mapInitialized);
                apex.jQuery('#MONUMENT_MAP').on('spatialmapchanged apexafterrefresh', updateList);
                apex.jQuery('#FACETS').on('facetschange', updateList);
                const initialRegion = apex.region('MONUMENT_MAP');
                const initialMap = initialRegion && initialRegion.getMapObject();
                if (initialMap) {
                    if (initialMap.loaded()) mapInitialized();
                    else initialMap.once('idle', mapInitialized);
                }
            })();
            ```
    }
    css {
        inline:
            ```css
            #MONUMENT_MAP .maplibregl-popup:has(.ndmm-info-window) {
                        width: 480px;
                        max-width: min(480px, calc(100vw - 48px)) !important;
                    }
                    #MONUMENT_MAP .maplibregl-popup:has(.ndmm-info-window) .maplibregl-popup-content {
                        padding: 10px 16px;
                    }
                    .ndmm-info-window {
                        max-height: 220px;
                        overflow-y: auto;
                        overflow-wrap: anywhere;
                    }
            ```
    }
    help {
        helpText: 災害種別と災害名で絞り込み、地図のポイントをクリックすると伝承内容を確認できます。一覧とファセットの候補・件数は地図の表示範囲と検索条件に連動します。
    }

    region ATTRIBUTION (
        name: 出典・加工内容とデータ利用について
        type: staticContent
        source {
            htmlCode:
                ```html
                <p>出典：<a href="https://www.gsi.go.jp/bousaichiri/denshouhi.html" target="_blank" rel="noopener noreferrer">国土地理院「自然災害伝承碑」</a>（2026年8月27日版 GeoJSON）。</p>
                <p>加工・編集：本アプリケーションの作成者が、GeoJSONの属性名を英語列名に対応付け、公開日を日付型に変換し、経緯度をOracle Spatialの位置情報に変換して、検索・地図・一覧表示用に構成しました。国土地理院が作成したアプリケーションではありません。</p>
                <p>同じ災害でも災害名の表記が異なる場合があります。情報は各市区町村から提供されたものです。各碑の制限事項をご確認ください。写真の二次利用に別途確認が必要な場合があります。</p>
                <p><a href="https://www.gsi.go.jp/kikakuchousei/kikakuchousei40182.html" target="_blank" rel="noopener noreferrer">国土地理院コンテンツ利用規約</a> ／ <a href="https://www.gsi.go.jp/bousaichiri/denshouhi_citylist.html" target="_blank" rel="noopener noreferrer">市町村別掲載情報一覧</a></p>
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: ATTRIBUTION
        }
    )

    region FACETS (
        name: 災害から探す
        type: facetedSearch
        source {
            filteredRegion: @MONUMENT_MAP
        }
        layout {
            sequence: 10
            slot: leftColumn
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: FACETS
        }
        settings {
            showCurrentFacets: true
            showTotalRowCount: true
        }

        facet P1_DISASTER_NAME (
            type: checkboxGroup
            label {
                label: 災害名
            }
            lov {
                type: distinctValues
            }
            layout {
                sequence: 20
            }
            listEntries {
                maxDisplayedEntries: 10
                displayFilterInitially: true
            }
            source {
                databaseColumn: DISASTER_NAME
            }
        )

        facet P1_DISASTER_TYPE (
            type: checkboxGroup
            label {
                label: 災害種別
            }
            lov {
                type: distinctValues
            }
            layout {
                sequence: 10
            }
            listEntries {
                maxDisplayedEntries: 10
                displayFilterInitially: true
            }
            source {
                databaseColumn: DISASTER_TYPE
            }
            multipleValues {
                type: delimitedList
                separator: ・
                filterCombination: and
            }
        )

    )

    region MONUMENT_LIST (
        name: 地図の表示範囲にある伝承碑一覧
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select MONUMENT_ID, MONUMENT_NAME, ESTABLISHED_YEAR, LOCATION, DISASTER_NAME, DISASTER_TYPE, TRADITION_CONTENT, to_char(PUBLISHED_DATE,'YYYY/MM/DD') PUBLISHED_DATE, REVISION_DATES, RESTRICTIONS, LONGITUDE, LATITUDE from NDMM_MONUMENTS
                where (:P1_DISASTER_TYPE is null or not exists (
                    select 1 from table(apex_string.split(:P1_DISASTER_TYPE, ':')) selected_type
                    where instr('・' || DISASTER_TYPE || '・', '・' || selected_type.column_value || '・') = 0
                ))
                and (:P1_DISASTER_NAME is null or DISASTER_NAME in (select column_value from table(apex_string.split(:P1_DISASTER_NAME,':'))))
                and (:P1_SOUTH is null or LATITUDE between to_number(:P1_SOUTH) and to_number(:P1_NORTH))
                and (:P1_WEST is null or
                 (to_number(:P1_WEST) <= to_number(:P1_EAST) and LONGITUDE between to_number(:P1_WEST) and to_number(:P1_EAST)) or
                 (to_number(:P1_WEST) > to_number(:P1_EAST) and (LONGITUDE >= to_number(:P1_WEST) or LONGITUDE <= to_number(:P1_EAST))))
                order by MONUMENT_ID
                            
                ```
            pageItemsToSubmit: [
                P1_DISASTER_TYPE
                P1_DISASTER_NAME
                P1_WEST
                P1_EAST
                P1_SOUTH
                P1_NORTH
            ]
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
            ]
        }
        advanced {
            htmlDomId: MONUMENT_LIST
        }
        componentAppearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        pagination {
            type: rowRangesXToYOfZWithPagination
            displayPosition: topAndBottomRight
        }

        column DISASTER_NAME (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: 災害名
            }
            layout {
                sequence: 50
            }
            comments {
                comments: 国土地理院GeoJSONの災害名を表示。編集機能なし。
            }
        )

        column DISASTER_TYPE (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: 災害種別
            }
            layout {
                sequence: 60
            }
            comments {
                comments: 国土地理院GeoJSONの災害種別を表示。編集機能なし。
            }
        )

        column ESTABLISHED_YEAR (
            reportColumnQueryId: 3
            derivedColumn: N
