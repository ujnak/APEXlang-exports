            comments {
                comments: 国土地理院GeoJSONの経度を表示。編集機能なし。
            }
        )

        column MONUMENT_ID (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: ID
            }
            layout {
                sequence: 10
            }
            comments {
                comments: 国土地理院GeoJSONのIDを表示。編集機能なし。
            }
        )

        column MONUMENT_NAME (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: 碑名
            }
            layout {
                sequence: 20
            }
            comments {
                comments: 国土地理院GeoJSONの碑名を表示。編集機能なし。
            }
        )

        column PUBLISHED_DATE (
            reportColumnQueryId: 8
            derivedColumn: N
            heading {
                heading: 公開日
            }
