aiAgent get-polygon-from-a-prompt (
    name: Get Polygon from a prompt
    genAI {
        service: @gemma-4
        systemPrompt: プロンプトに関連する地域を推測し、その地域を囲むポリゴンをGeoJSONのPolygonとして生成してください。
    }
    responseFormat {
        type: jsonObject
        jsonSchema:
            ```json
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "enum": ["Polygon"]
                },
                "coordinates": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "array",
                    "minItems": 4,
                    "items": {
                      "type": "array",
                      "minItems": 2,
                      "maxItems": 2,
                      "items": {
                        "type": "number"
                      }
                    }
                  }
                }
              },
              "required": [
                "type",
                "coordinates"
              ],
              "additionalProperties": false
            }
            ```
    }
)

