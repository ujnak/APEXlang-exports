app MAPTERHORN-PMTILES (
    name: Mapterhorn PMTiles
    logo {
        type: text
        text: Mapterhorn PMTiles
    }
    navigation {
        homeUrl: {
            page: 1
        }
        loginUrl: {
            page: LOGIN
        }
    }
    navigationMenu {
        listTemplate: @/side-navigation-menu
        templateOptions: [
            #DEFAULT#
            t-TreeNav--styleA
            js-navCollapsed--hidden
        ]
        list: @ナビゲーション-メニュー
    }
    navigationBar {
        list: @ナビゲーション-バー
        listTemplate: @/navigation-bar
        templateOptions: #DEFAULT#
    }
    userInterface {
        currentTheme: @universal-theme
        globalPage: 0
        addBuiltWithApexToFooter: false
    }
    appFormatMasks {
        date: DS
        timestamp: DS
        timestampTimeZone: DS
    }
    authentication {
        scheme: @oracle-apexアカウント
    }
    sessionStateProtection {
        checksumSalt: 358EA25766B084CCB074BACCD2EB515B3BADE3415D33510F70A4350F7F023CEC
    }
    globalization {
        primaryLanguage: ja
    }
    runtime {
        allowFeedback: true
    }

    substitution APP_NAME (
        value {
            staticValue: Mapterhorn PMTiles
        }
    )

)

