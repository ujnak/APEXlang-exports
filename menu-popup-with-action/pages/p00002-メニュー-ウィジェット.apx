page 2 (
    name: メニュー・ウィジェット
    alias: メニュー-ウィジェット
    title: メニュー・ウィジェット
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        executeWhenPageLoads:
            ```javascript-browser
            apex.actions.add( {
                name: "select-job",
                get: () => {
                    return apex.item("P2_JOB").getValue();
                },
                set: (val) => {
                    apex.item("P2_JOB").setValue(val);
                    apex.region("EMP").refresh();
                },
                choices: [
                    {
                        label: "ANALYST",
                        value: "ANALYST"
                    },
                    {
                        label: "CLERK",
                        value: "CLERK"
                    },
                    {
                        label: "SALESMAN",
                        value: "SALESMAN"
                    },
                    {
                        label: "MANAGER",
                        value: "MANAGER"
                    },
                    {
                        label: "PRESIDENT",
                        value: "PRESIDENT"
                    }
                ]
            });
            
            $("#selectjob_menu").menu( {
                items:[
                    {
                        type:"radioGroup",
                        action: "select-job"
                    }
                ]
            });
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region employees (
        name: Employees
        type: classicReport
        source {
            location: localDatabase
            tableName: EMP
            whereClause: :P2_JOB is null or JOB = :P2_JOB
            pageItemsToSubmit: P2_JOB
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--hideHeader js-addHiddenHeadingRoleDesc
                t-Region--scrollBody
            ]
        }
        advanced {
            htmlDomId: EMP
        }
        reportLayout {
            numberOfRows: 50
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--staticRowColors
                t-Report--rowHighlight
                t-Report--inline
                t-Report--hideNoPagination
            ]
        }
        pagination {
            type: nextAndPreviousLinks
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: データが見つかりません
        }

        column COMM (
            reportColumnQueryId: 7
            derivedColumn: N
            heading {
                heading: Commission
                alignment: end
            }
            layout {
                sequence: 7
                columnAlignment: end
            }
            appearance {
                formatMask: 9990
            }
        )

        column DEPTNO (
            reportColumnQueryId: 8
            derivedColumn: N
            type: plainTextBasedOnLov
            heading {
                heading: Department
            }
            lov {
                type: sharedComponent
                lov: @dept-dname
            }
            layout {
                sequence: 8
            }
        )

        column EMPNO (
            reportColumnQueryId: 1
            derivedColumn: N
            type: hidden
            layout {
                sequence: 0
            }
        )

        column ENAME (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Employee Name
            }
            layout {
                sequence: 2
            }
        )

        column HIREDATE (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Hired
                alignment: center
            }
            layout {
                sequence: 5
                columnAlignment: center
            }
        )

        column JOB (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Job
            }
            layout {
                sequence: 3
            }
        )

        column MGR (
            reportColumnQueryId: 4
            derivedColumn: N
            type: plainTextBasedOnLov
            heading {
                heading: Manager
            }
            lov {
                type: sharedComponent
                lov: @emp-ename
            }
            layout {
                sequence: 4
            }
        )

        column SAL (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Salary
                alignment: end
            }
            layout {
                sequence: 6
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G999G999G999G999G999G990
            }
        )

    )

    region ジョブのリスト (
        name: ジョブのリスト
        type: staticContent
        source {
            htmlCode: <div id="selectjob_menu"></div>
        }
        layout {
            sequence: 40
            slot: dialogsDrawersAndPopups
        }
        appearance {
            template: @/blank-with-attributes-no-grid
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region メニュー-ウィジェット (
        name: メニュー・ウィジェット
        type: staticContent
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/hero
            templateOptions: #DEFAULT#
        }
        image {
            fileUrl: #APP_FILES#icons/app-icon-512.png
        }
    )

    pageItem P2_JOB (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 30
            slot: body
        }
    )

    button select-job (
        buttonName: SELECT_JOB
        label: Select Job
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
        advanced {
            customAttributes: data-menu="selectjob_menu"
        }
    )

)

