lov dept-dname (
    name: DEPT.DNAME
    source {
        tableName: DEPT
    }
    columnMapping {
        return: DEPTNO
        display: DNAME
        defaultSort: DNAME
    }
)

lov emp-ename (
    name: EMP.ENAME
    source {
        tableName: EMP
    }
    columnMapping {
        return: EMPNO
        display: ENAME
        defaultSort: ENAME
    }
)

