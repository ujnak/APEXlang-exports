list navigation-bar (
    name: Navigation Bar

    entry app-user (
        label: &APP_USER.
        icon {
            imageIconCssClasses: fa-user
        }
        layout {
            sequence: 10
        }
        link {
            target: {
                type: url
                url: #
            }
        }
        userDefinedAttributes {
            2: has-username
        }
    )

    entry list_item (
        label: ---
        layout {
            sequence: 20
            parentEntry: @app-user
        }
        link {
            target: {
                type: url
                url: separator
            }
        }
        serverSideCondition {
            type: userIsAuthenticated
        }
    )

    entry sign-out (
        label: Sign Out
        icon {
            imageIconCssClasses: fa-sign-out
        }
        layout {
            sequence: 30
            parentEntry: @app-user
        }
        link {
            target: {
                type: url
                url: &LOGOUT_URL.
            }
        }
        serverSideCondition {
            type: userIsAuthenticated
        }
    )

)

list navigation-menu (
    name: Navigation Menu

    entry messages (
        label: Messages
        icon {
            imageIconCssClasses: fa-table-pointer
        }
        layout {
            sequence: 30
        }
        link {
            target: {
                page: 4
            }
        }
    )

    entry translate (
        label: Translate
        icon {
            imageIconCssClasses: fa-globe
        }
        layout {
            sequence: 20
        }
        link {
            target: {
                page: 3
            }
        }
    )

    entry xliff-files (
        label: XLIFF Files
        icon {
            imageIconCssClasses: fa-table
        }
        layout {
            sequence: 10
        }
        link {
            target: {
                page: 1
            }
        }
    )

)

