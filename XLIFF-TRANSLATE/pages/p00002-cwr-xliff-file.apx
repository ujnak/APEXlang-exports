page 2 (
    name: Cwr Xliff File
    alias: CWR-XLIFF-FILE
    title: Cwr Xliff File
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/drawer
        templateOptions: [
            #DEFAULT#
            js-dialog-class-t-Drawer--pullOutEnd
        ]
    }
    dialog {
        chained: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
    )

    region cwr-xliff-file (
        name: Cwr Xliff File
        type: form
        source {
            location: localDatabase
            tableName: CWR_XLIFF_FILES
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    pageItem P2_ID (
        type: hidden
        layout {
            sequence: 10
            region: @cwr-xliff-file
            slot: regionBody
        }
        source {
            formRegion: @cwr-xliff-file
            column: ID
            dataType: number
            queryOnly: true
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P2_NAME (
        type: textField
        label {
            label: Name
            alignment: right
        }
        layout {
            sequence: 20
            region: @cwr-xliff-file
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
            maxLength: 255
        }
        source {
            formRegion: @cwr-xliff-file
            column: NAME
            dataType: varchar2
        }
    )

    pageItem P2_SOURCE_LANG (
        type: textField
        label {
            label: Source Lang
            alignment: left
        }
        layout {
            sequence: 30
            region: @cwr-xliff-file
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 50
        }
        source {
            formRegion: @cwr-xliff-file
            column: SOURCE_LANG
            dataType: varchar2
        }
        config {
            buildOption: @commented-out
        }
    )

    pageItem P2_TARGET_LANG (
        type: textField
        label {
            label: Target Lang
            alignment: left
        }
        layout {
            sequence: 40
            region: @cwr-xliff-file
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 50
        }
        source {
            formRegion: @cwr-xliff-file
            column: TARGET_LANG
            dataType: varchar2
        }
        config {
            buildOption: @commented-out
        }
    )

    pageItem P2_XLIFF_RESULT (
        type: fileUpload
        label {
            label: Xliff Result
            alignment: left
        }
        layout {
            sequence: 50
            region: @cwr-xliff-file
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 60
        }
        validation {
            maxLength: 255
        }
        source {
            formRegion: @cwr-xliff-file
            column: XLIFF_RESULT
            dataType: blob
        }
        config {
            buildOption: @commented-out
        }
    )

    pageItem P2_XLIFF_RESULT_CHARSET (
        type: hidden
        layout {
            sequence: 80
            region: @cwr-xliff-file
            slot: regionBody
        }
        source {
            formRegion: @cwr-xliff-file
            column: XLIFF_RESULT_CHARSET
            dataType: varchar2
        }
        config {
            buildOption: @commented-out
        }
    )

    pageItem P2_XLIFF_RESULT_FILENAME (
        type: hidden
        layout {
            sequence: 60
            region: @cwr-xliff-file
            slot: regionBody
        }
        source {
            formRegion: @cwr-xliff-file
            column: XLIFF_RESULT_FILENAME
            dataType: varchar2
        }
        config {
            buildOption: @commented-out
        }
    )

    pageItem P2_XLIFF_RESULT_LASTUPD (
        type: hidden
        layout {
            sequence: 90
            region: @cwr-xliff-file
            slot: regionBody
        }
        source {
            formRegion: @cwr-xliff-file
            column: XLIFF_RESULT_LASTUPD
            dataType: date
        }
        config {
            buildOption: @commented-out
        }
    )

    pageItem P2_XLIFF_RESULT_MIMETYPE (
        type: hidden
        layout {
            sequence: 70
            region: @cwr-xliff-file
            slot: regionBody
        }
        source {
            formRegion: @cwr-xliff-file
            column: XLIFF_RESULT_MIMETYPE
            dataType: varchar2
        }
        config {
            buildOption: @commented-out
        }
    )

    pageItem P2_XLIFF_SOURCE (
        type: fileUpload
        label {
            label: Xliff Source
            alignment: left
        }
        storage {
            mimeTypeColumn: XLIFF_SOURCE_MIMETYPE
            filenameColumn: XLIFF_SOURCE_FILENAME
            charSetColumn: XLIFF_SOURCE_CHARSET
            bobLastUpdatedColumn: XLIFF_SOURCE_LASTUPD
        }
        layout {
            sequence: 100
            region: @cwr-xliff-file
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 60
        }
        validation {
            maxLength: 255
        }
        source {
            formRegion: @cwr-xliff-file
            column: XLIFF_SOURCE
            dataType: blob
        }
    )

    pageItem P2_XLIFF_SOURCE_CHARSET (
        type: hidden
        layout {
            sequence: 130
            region: @cwr-xliff-file
            slot: regionBody
        }
        source {
            formRegion: @cwr-xliff-file
            column: XLIFF_SOURCE_CHARSET
            dataType: varchar2
        }
    )

    pageItem P2_XLIFF_SOURCE_FILENAME (
        type: hidden
        layout {
            sequence: 110
            region: @cwr-xliff-file
            slot: regionBody
        }
        source {
            formRegion: @cwr-xliff-file
            column: XLIFF_SOURCE_FILENAME
            dataType: varchar2
        }
    )

    pageItem P2_XLIFF_SOURCE_LASTUPD (
        type: hidden
        layout {
            sequence: 140
            region: @cwr-xliff-file
            slot: regionBody
        }
        source {
            formRegion: @cwr-xliff-file
            column: XLIFF_SOURCE_LASTUPD
            dataType: date
        }
    )

    pageItem P2_XLIFF_SOURCE_MIMETYPE (
        type: hidden
        layout {
            sequence: 120
            region: @cwr-xliff-file
            slot: regionBody
        }
        source {
            formRegion: @cwr-xliff-file
            column: XLIFF_SOURCE_MIMETYPE
            dataType: varchar2
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: triggerAction
        }

        triggerAction native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
            }
        )

    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P2_ID
        }
    )

    button delete (
        buttonName: DELETE
        label: Delete
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--danger
                t-Button--simple
            ]
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P2_ID
        }
    )

    button save (
        buttonName: SAVE
        label: Apply Changes
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P2_ID
        }
    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 11584638465846316
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

    process initialize-form-cwr-xliff-file (
        name: Initialize form Cwr Xliff File
        type: formInitialization
        formRegion: @cwr-xliff-file
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 11583812033846315
        }
    )

    process process-form-cwr-xliff-file (
        name: Process form Cwr Xliff File
        type: formAutoRowProcessing
        formRegion: @cwr-xliff-file
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 11584213068846315
        }
    )

)

