    button translate (
        buttonName: TRANSLATE
        label: Translate
        layout {
            sequence: 40
            region: @ai-translate
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: triggerAction
        }

        triggerAction native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare
                        l_prompt   clob;
                        l_request  clob;
                        l_response clob;
                        l_json     json_object_t;
                    begin
                        l_prompt := '日本語の単語「' || :P3_SOURCE_TEXT || '」を' ||
                            case :P3_TARGET_LANG when 'en' then '英語' when 'zh-cn' then '簡体中国語' when 'ko' then '韓国語' else '日本語' end
                            || 'に翻訳してください。¥n出力は以下の形式のJSONで返してください。¥n出力はJSONドキュメントだけを返してください。¥n
                    {
                        "source_text": "翻訳対象の単語",
                        "source_lang": "翻訳元の言語（デフォルトはja）",
                        "target_lang": "翻訳先の言語",
                        "target_text": "翻訳された単語"
                    }';
                        /* AIへ送信するメッセージ */
                        select json_object(
                            key 'source_text' value :P3_SOURCE_TEXT,
                            key 'source_lang' value 'ja',
                            key 'target_lang' value :P3_TARGET_LANG
                        ) into l_request from dual;
                        apex_debug.info(l_request);
                        l_response := apex_ai.generate(
                            p_agent_static_id => 'TRANSLATE_WORD'
                            ,p_prompt => l_prompt
                        );
                        apex_debug.info(l_response);
                        l_json := json_object_t.parse(l_response);
                        :P3_TARGET_TEXT := l_json.get_string('target_text');
                    end;
                    ```
                itemsToSubmit: [
                    P3_SOURCE_TEXT
                    P3_SOURCE_LANG
                    P3_TARGET_LANG
                ]
                itemsToReturn: P3_TARGET_TEXT
                showProcessing: true
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction close-dialog-as-cancel (
        name: Close Dialog as Cancel
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-close-region (
            action: closeRegion
            affectedElements {
                selectionType: region
                region: @ai-translate
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

