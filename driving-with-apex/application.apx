app DRIVING-WITH-APEX (
    name: Driving with APEX
    logo {
        type: text
        text: Driving with APEX
    }
    navigation {
        homeUrl: {
            page: 1
        }
        loginUrl: {
            page: LOGIN
        }
    }
    navigationMenu {
        listTemplate: @/side-navigation-menu
        templateOptions: [
            #DEFAULT#
            t-TreeNav--styleA
            js-navCollapsed--hidden
        ]
        list: @ナビゲーション-メニュー
    }
    navigationBar {
        list: @ナビゲーション-バー
        listTemplate: @/navigation-bar
        templateOptions: #DEFAULT#
    }
    userInterface {
        currentTheme: @universal-theme
        globalPage: 0
        addBuiltWithApexToFooter: false
    }
    appFormatMasks {
        date: DS
        timestamp: DS
        timestampTimeZone: DS
    }
    authentication {
        scheme: @oracle-apexアカウント
    }
    sessionStateProtection {
        checksumSalt: 004A15DE5A29E6A7613AD76FD1AAC9E6DCD49016442BEB5BF0204171238AD2FC
    }
    globalization {
        primaryLanguage: ja
    }
    runtime {
        allowFeedback: true
    }

    substitution APP_NAME (
        value {
            staticValue: Driving with APEX
        }
    )

)

